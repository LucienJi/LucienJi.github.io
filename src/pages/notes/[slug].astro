---
/**
 * /notes/[slug] — A single note (DESIGN.md §7.8).
 *
 * getStaticPaths builds one page per non-draft note (params.slug = entry.id).
 * The MDX body renders through <Prose> in the 720px reading column, headed by
 * the title (the page's single <h1>), a mono date, and mono tag chips.
 *
 * Built regardless of `site.features.notes`; that flag only governs nav linking.
 */
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Prose from "@components/Prose.astro";
import Tag from "@components/Tag.astro";
import { withBase } from "@lib/url";
import { site } from "@data/site";

export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"notes">;
}

const { entry } = Astro.props;
const { title, date, summary, tags } = entry.data;
const { Content } = await render(entry);

// Mono date grammar; UTC-stable display with an ISO value on the <time>.
const formatDate = (d: Date): string =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
const isoDate = (d: Date): string => d.toISOString().slice(0, 10);
---

<BaseLayout title={title} description={summary ?? `${title} — a note by ${site.name}.`}>
  <article class="section wrap-read note-page">
    <header class="note-page__head">
      <a class="note-page__back" href={withBase("/notes")} aria-label="Back to all notes">
        <span aria-hidden="true">←</span> Notes
      </a>

      <h1 class="note-page__title">{title}</h1>

      <div class="note-page__meta">
        <time class="note-page__date" datetime={isoDate(date)}>{formatDate(date)}</time>
        {
          tags.length > 0 && (
            <ul class="note-page__tags" role="list">
              {tags.map((t) => (
                <li>
                  <Tag label={t} />
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {summary && <p class="lede note-page__summary">{summary}</p>}
    </header>

    <Prose>
      <Content />
    </Prose>
  </article>
</BaseLayout>

<style>
  /* Title block: a hairline rule separates it from the prose, paper-style. */
  .note-page__head {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--line);
  }

  .note-page__back {
    display: inline-block;
    margin-bottom: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.04em;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .note-page__back:hover,
  .note-page__back:focus-visible {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  /* Date + tags share one mono metadata row. */
  .note-page__meta {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }
  .note-page__date {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }
  .note-page__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .note-page__summary {
    margin-top: var(--space-6);
  }
</style>
