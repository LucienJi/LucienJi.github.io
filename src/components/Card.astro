---
// The SHARED chassis (DESIGN.md §6.9): 1px hairline frame + soft shadow +
// optional mono metadata strip. PaperCard, PhotoPlate, ProjectCard and
// TimelineEntry all compose this — same chassis, different cargo.
//
// Slots: "media" (full-bleed top), default (padded body), "meta" (footer strip).
import { withBase, isExternal } from "../lib/url";

interface Props {
  href?: string;
  class?: string;
  pad?: boolean;
  hover?: boolean;
}
const { href, class: className = "", pad = true, hover = false } = Astro.props;
const ext = href ? isExternal(href) : false;
const Tag = href ? "a" : "article";
const hrefAttr = href ? (ext ? href : withBase(href)) : undefined;
const hasBody = Astro.slots.has("default");
const hasMeta = Astro.slots.has("meta");
---

<Tag
  class={`card ${hover ? "card--hover" : ""} ${className}`}
  href={hrefAttr}
  target={ext ? "_blank" : undefined}
  rel={ext ? "noopener noreferrer" : undefined}
>
  <slot name="media" />
  {hasBody && <div class={`card__body ${pad ? "card__body--pad" : ""}`}><slot /></div>}
  {hasMeta && <div class="card__meta"><slot name="meta" /></div>}
</Tag>

<style>
  .card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
  }
  .card__body--pad { padding: var(--card-pad); }
  .card__meta {
    padding: var(--space-3) var(--card-pad);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--faint);
  }
  .card--hover {
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .card--hover:hover,
  .card--hover:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 30%, var(--line));
  }
</style>
