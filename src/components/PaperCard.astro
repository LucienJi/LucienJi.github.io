---
/**
 * PaperCard — one publication rendered on the shared <Card> chassis
 * (DESIGN.md §6.10, §7.2). Same chassis as PhotoPlate / TimelineEntry, different
 * cargo: a paper's title, authors, venue, plain-language one-liner and links.
 *
 * Composition (the task surface):
 *   • title   — serif <h3>, linked to links.project (a logical/internal path)
 *               → else links.pdf → else links.arxiv; plain text when none.
 *   • authors — serif line; the author whose string === site.name is <strong>.
 *               A trailing "*" marks equal contribution: it renders as a
 *               superscript and adds a one-line "Equal contribution" note.
 *   • venue   — <VenueBadge venue year type award>. NOTE: VenueBadge already
 *               renders `award` as its cobalt sub-tag, so the award badge is
 *               shown here once and never duplicated.
 *   • note    — the oneLiner as a muted serif line (optional).
 *   • links   — a mono, dot-separated row of the available links
 *               (PDF · arXiv · Code · Project · Website · Video), external-aware,
 *               plus <CopyBibTeX> when a bibtex string exists. CopyBibTeX needs a
 *               single <Toast/> placed on the page to surface "Copied ✓".
 *
 * The whole card is NOT a single link (the title and each row link are their own
 * controls), which keeps interactive elements from nesting. Empty / "#"
 * placeholder links are treated as absent so the card never emits a dead link
 * (both for the title fallback and the row). Composes design tokens only; the
 * foundation is never modified.
 */
import type { CollectionEntry } from "astro:content";
import Card from "@components/Card.astro";
import VenueBadge from "@components/VenueBadge.astro";
import CopyBibTeX from "@components/CopyBibTeX.astro";
import { site } from "@data/site";
import { withBase, isExternal } from "@lib/url";

interface Props {
  entry: CollectionEntry<"publications">;
}

const { entry } = Astro.props;
const { title, authors, venue, year, type, links, oneLiner, award } = entry.data;

// A link value is "real" only when it is a non-empty string and not the "#"
// placeholder used in seed content — this keeps dead links out of the card.
const hasLink = (v: string | undefined): v is string =>
  typeof v === "string" && v.trim() !== "" && v.trim() !== "#";

// Internal hrefs get base-prefixed; external ones (http/mailto/tel) pass through
// and carry target/rel. Mirrors the foundation's Card/Tag behaviour.
const resolve = (raw: string) => {
  const external = isExternal(raw);
  return { href: external ? raw : withBase(raw), external };
};

// Title destination: prefer the logical project path, then the PDF, then arXiv.
const titleRaw = [links?.project, links?.pdf, links?.arxiv].find(hasLink);
const titleLink = titleRaw ? resolve(titleRaw) : null;

// The action row, in the canonical reading order.
const linkRow = (
  [
    ["pdf", "PDF"],
    ["arxiv", "arXiv"],
    ["code", "Code"],
    ["project", "Project"],
    ["website", "Website"],
    ["video", "Video"],
  ] as const
)
  .filter(([key]) => hasLink(links?.[key]))
  .map(([key, label]) => ({ label, ...resolve(links?.[key] as string) }));

// BibTeX is a literal entry (not a URL), so it only needs a non-empty check.
const bibtex =
  links?.bibtex && links.bibtex.trim() !== "" ? links.bibtex : undefined;

const hasRow = linkRow.length > 0 || Boolean(bibtex);

// "Name*" = equal contribution; the bare name is what gets matched and shown.
const authorList = authors.map((raw) => {
  const equal = raw.endsWith("*");
  return { name: equal ? raw.slice(0, -1).trim() : raw, equal };
});
const hasEqual = authorList.some((a) => a.equal);
---

<Card>
  <div class="paper">
    <h3 class="paper__title">
      {
        titleLink ? (
          <a
            class="link"
            href={titleLink.href}
            target={titleLink.external ? "_blank" : undefined}
            rel={titleLink.external ? "noopener noreferrer" : undefined}
          >
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>

    <p class="paper__authors">
      {
        authorList.map((author, i) => (
          <Fragment>
            {i > 0 && ", "}
            {author.name === site.name ? <strong>{author.name}</strong> : author.name}
            {author.equal && <sup>*</sup>}
          </Fragment>
        ))
      }
      {hasEqual && <span class="paper__equal">* Equal contribution</span>}
    </p>

    <div class="paper__venue">
      <VenueBadge venue={venue} year={year} type={type} award={award} />
    </div>

    {oneLiner && <p class="paper__note">{oneLiner}</p>}

    {
      hasRow && (
        <ul class="paper__links" role="list">
          {linkRow.map((l) => (
            <li>
              <a
                class="paper__link"
                href={l.href}
                target={l.external ? "_blank" : undefined}
                rel={l.external ? "noopener noreferrer" : undefined}
              >
                {l.label}
              </a>
            </li>
          ))}
          {bibtex && (
            <li>
              <CopyBibTeX bibtex={bibtex} />
            </li>
          )}
        </ul>
      )
    }
  </div>
</Card>

<style>
  /* Vertical rhythm between the card's stacked blocks. */
  .paper > * + * {
    margin-top: var(--space-3);
  }

  /* Title — the serif "voice". The <a> uses the global .link treatment so the
     title stays ink and only the cobalt underline animates on hover/focus. */
  .paper__title {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    text-wrap: balance;
  }

  /* Authors — secondary serif; the self-author is emphasised (DESIGN rule). */
  .paper__authors {
    font-family: var(--font-serif);
    font-size: var(--fs-ui);
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .paper__authors strong {
    color: var(--ink);
    font-weight: 600;
  }
  .paper__authors sup {
    font-size: 0.75em;
    line-height: 0;
  }
  .paper__equal {
    display: block;
    font-size: var(--fs-meta);
    color: var(--faint);
  }

  /* Block wrapper so the inline-flex VenueBadge hugs the left edge. */
  .paper__venue {
    display: flex;
  }

  /* The plain-language one-liner, as a muted note. */
  .paper__note {
    color: var(--muted);
    text-wrap: pretty;
  }

  /* Action row — mono, cobalt, dot-separated; a touch more air above it. */
  .paper__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: 0;
  }
  .paper__links > li {
    display: inline-flex;
    align-items: center;
  }
  .paper__links > li + li::before {
    content: "·";
    margin-inline-end: var(--space-2);
    color: var(--faint);
  }

  /* Row links match the CopyBibTeX treatment for a uniform mono action row:
     cobalt, with the underline drawing on hover AND focus (keyboard-equal). */
  .paper__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--space-6); /* 24px target (DESIGN §6/§10) */
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.04em;
    color: var(--accent);
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% 1px;
    padding-bottom: 1px;
    transition:
      background-size var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .paper__link:hover,
  .paper__link:focus-visible {
    color: var(--accent-press);
    background-size: 100% 1px;
  }
</style>
