---
// astro:assets wrapper: AVIF/WebP responsive srcset, zero-CLS aspect box,
// alt REQUIRED. Accepts an image *basename* (resolved from src/assets/**) or
// an imported ImageMetadata. Set `mat` to render it as a matted "hung print".
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { mustResolveImage } from "../lib/images";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean; // eager + high fetchpriority for LCP
  mat?: boolean;
  aspect?: number; // width/height override
  class?: string;
}
const {
  src,
  alt,
  widths,
  sizes = "(min-width: 1140px) 1100px, 100vw",
  priority = false,
  mat = false,
  aspect,
  class: className = "",
} = Astro.props;

const img = mustResolveImage(src);
const ratio = aspect ?? img.width / img.height;
let wlist = (widths ?? [400, 640, 960, 1280, 1600, 2000]).filter((w) => w <= img.width);
if (wlist.length === 0) wlist = [img.width];
---

<div class={`rimg ${mat ? "rimg--mat" : ""} ${className}`} style={`--ratio:${ratio}`}>
  <Picture
    src={img}
    formats={["avif", "webp"]}
    widths={wlist}
    sizes={sizes}
    alt={alt}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
    class="rimg__img"
  />
</div>

<style>
  .rimg { margin: 0; }
  .rimg__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    background: var(--surface);
    border-radius: var(--radius);
  }
  .rimg--mat {
    background: var(--mat);
    padding: clamp(8px, 1.4vw, 16px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }
  .rimg--mat .rimg__img { border-radius: 0; }
</style>
