---
// Lightbox — a single, full-screen image viewer. Include ONCE per gallery page
// (e.g. /photography and /photography/[series]); it takes no props.
//
// It owns no images of its own. On `astro:page-load` it collects every
// `[data-lightbox-trigger]` in the document (in document order) and wires each
// one to open the viewer at its index. Triggers are produced by <PhotoPlate>,
// which renders a <button data-lightbox-trigger> carrying:
//   data-src      — a large, already base-correct image URL (astro:assets)
//   data-alt      — the image's alt text
//   data-caption  — the mono caption (e.g. "Plate IV — Kyoto, 2024")
// Because triggers are <button>s, a native click already covers Enter/Space,
// so wiring "click" satisfies pointer + keyboard activation.
//
// The overlay carries data-theme="dark" so it always renders on the Nocturne
// palette (DESIGN §8.1 "lightbox always dark") regardless of the page theme —
// the dark tokens are inherited from the existing [data-theme="dark"] rule, so
// nothing here hardcodes a colour. No internal hrefs exist, so withBase() is
// not needed. The viewed image is a runtime <img> (its URL is resolved by the
// trigger), which is why <ResponsiveImage> is intentionally not used here.
---

<div
  class="lightbox"
  data-lightbox
  data-theme="dark"
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
  tabindex="-1"
>
  <button
    class="lightbox__btn lightbox__close"
    type="button"
    data-lightbox-close
    aria-label="Close image viewer"
  >
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>

  <button
    class="lightbox__btn lightbox__prev"
    type="button"
    data-lightbox-prev
    aria-label="Previous image"
  >
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" />
    </svg>
  </button>

  <figure class="lightbox__figure">
    <img class="lightbox__img" data-lightbox-img alt="" decoding="async" />
    <figcaption class="lightbox__meta" data-lightbox-meta aria-live="polite">
      <span class="lightbox__caption" data-lightbox-caption></span>
      <span class="lightbox__counter mono" data-lightbox-counter></span>
    </figcaption>
  </figure>

  <button
    class="lightbox__btn lightbox__next"
    type="button"
    data-lightbox-next
    aria-label="Next image"
  >
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 5l7 7-7 7" />
    </svg>
  </button>
</div>

<script>
  function initLightbox() {
    const overlay = document.querySelector<HTMLElement>("[data-lightbox]");
    if (!overlay) return; // page has no lightbox

    const img = overlay.querySelector<HTMLImageElement>("[data-lightbox-img]");
    const captionEl = overlay.querySelector<HTMLElement>("[data-lightbox-caption]");
    const counterEl = overlay.querySelector<HTMLElement>("[data-lightbox-counter]");
    const closeBtn = overlay.querySelector<HTMLButtonElement>("[data-lightbox-close]");
    const prevBtn = overlay.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
    const nextBtn = overlay.querySelector<HTMLButtonElement>("[data-lightbox-next]");
    if (!img || !captionEl || !counterEl || !closeBtn || !prevBtn || !nextBtn) return;

    // Re-collected every navigation: the set of plates differs per page.
    const triggers = Array.from(
      document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]"),
    );

    let index = -1;
    let opener: HTMLElement | null = null; // restore focus here on close

    const pad = (n: number) => String(n).padStart(2, "0");

    const lockScroll = () => {
      document.documentElement.style.overflow = "hidden";
    };
    const unlockScroll = () => {
      document.documentElement.style.overflow = "";
    };

    // Robust modal isolation for AT that ignores aria-modal (screen-reader
    // browse mode): make every branch outside the dialog `inert`. The overlay
    // lives inside <main>, so inert main's *other* children plus every
    // body-level branch that does not contain the dialog.
    const setBackgroundInert = (on: boolean) => {
      const blocks: Element[] = [];
      for (const el of Array.from(document.body.children)) {
        if (!el.contains(overlay)) blocks.push(el);
      }
      const main = overlay.parentElement;
      if (main) {
        for (const el of Array.from(main.children)) {
          if (el !== overlay) blocks.push(el);
        }
      }
      for (const el of blocks) el.toggleAttribute("inert", on);
    };

    // Tab-trap targets: the visible, enabled controls inside the dialog.
    const getFocusable = (): HTMLElement[] =>
      Array.from(
        overlay.querySelectorAll<HTMLElement>("button:not([disabled]):not([hidden])"),
      );

    // Defined as arrow expressions (not hoisted declarations) so TypeScript
    // carries the const guards above (overlay/img/…) into these closures.
    const show = (i: number) => {
      const total = triggers.length;
      if (total === 0) return;
      index = ((i % total) + total) % total; // wrap, robust to negatives
      const trigger = triggers[index];
      const src = trigger.dataset.src ?? "";
      const caption = trigger.dataset.caption ?? "";

      img.classList.remove("is-ready");
      img.alt = trigger.dataset.alt ?? "";
      if (src) img.src = src;
      // Cached/same-src images may not refire "load"; reveal immediately.
      if (img.complete && img.naturalWidth > 0) img.classList.add("is-ready");

      captionEl.textContent = caption;
      captionEl.hidden = caption === "";
      counterEl.textContent = `${pad(index + 1)} / ${pad(total)}`;
    }

    const open = (i: number) => {
      opener = triggers[i] ?? (document.activeElement as HTMLElement | null);
      show(i);
      overlay.classList.add("is-open");
      lockScroll();
      setBackgroundInert(true);
      overlay.focus(); // announces the dialog (aria-label); Tab moves to controls
    }

    const close = () => {
      if (!overlay.classList.contains("is-open")) return;
      overlay.classList.remove("is-open");
      unlockScroll();
      setBackgroundInert(false);
      if (opener && typeof opener.focus === "function") opener.focus();
      opener = null;
    }

    const trapTab = (event: KeyboardEvent) => {
      const focusable = getFocusable();
      if (focusable.length === 0) {
        event.preventDefault();
        return;
      }
      const active = document.activeElement as HTMLElement | null;
      const idx = active ? focusable.indexOf(active) : -1;
      event.preventDefault();
      let next: HTMLElement;
      if (event.shiftKey) {
        next = idx <= 0 ? focusable[focusable.length - 1] : focusable[idx - 1];
      } else {
        next = idx === -1 || idx === focusable.length - 1 ? focusable[0] : focusable[idx + 1];
      }
      next.focus();
    }

    // --- Triggers: bind once per element (idempotent across view transitions).
    // PhotoPlate triggers are <button>s, so a native click handles Enter/Space.
    triggers.forEach((trigger, i) => {
      if (trigger.dataset.lbBound) return;
      trigger.dataset.lbBound = "1";
      trigger.addEventListener("click", () => open(i));
    });

    // --- Overlay wiring: once per overlay instance (the overlay is recreated
    // on every navigation, so trigger + overlay handlers share one closure).
    if (overlay.dataset.bound) return;
    overlay.dataset.bound = "1";

    // Defensive: <html> persists across view transitions, so clear any stale
    // scroll lock. A freshly rendered overlay is always closed.
    unlockScroll();

    // A single image has nowhere to page to — drop the prev/next controls.
    if (triggers.length <= 1) {
      prevBtn.hidden = true;
      nextBtn.hidden = true;
    }

    img.addEventListener("load", () => img.classList.add("is-ready"));
    closeBtn.addEventListener("click", () => close());
    prevBtn.addEventListener("click", () => show(index - 1));
    nextBtn.addEventListener("click", () => show(index + 1));

    overlay.addEventListener("keydown", (event: KeyboardEvent) => {
      if (!overlay.classList.contains("is-open")) return;
      switch (event.key) {
        case "Escape":
          event.preventDefault();
          close();
          break;
        case "ArrowLeft":
          event.preventDefault();
          show(index - 1);
          break;
        case "ArrowRight":
          event.preventDefault();
          show(index + 1);
          break;
        case "Tab":
          trapTab(event);
          break;
      }
    });

    // Click the backdrop (anything but the photograph or a control) to close.
    overlay.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === img) return;
      if (target.closest("button")) return;
      close();
    });
  }

  document.addEventListener("astro:page-load", initLightbox);
</script>

<style>
  /* Always-dark, full-viewport overlay. data-theme="dark" (set in markup)
     resolves --ink/--muted/--faint/--focus to their Nocturne values, so the
     chrome reads on the dark backdrop regardless of the page theme. */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    padding: var(--space-12) var(--space-16) var(--space-8);
    background: var(--lightbox-backdrop);
    /* Closed by default — kept in the DOM but inert and out of the a11y tree.
       Opacity fades; visibility flips after the fade so it stays visible while
       closing. No transform is animated (reduced-motion friendly by design). */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur) var(--ease),
      visibility 0s linear var(--dur);
  }

  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--dur) var(--ease),
      visibility 0s linear 0s;
  }

  /* The dialog container only receives focus to announce itself; it is not an
     operable control, so suppress its ring (the buttons keep theirs). */
  .lightbox:focus-visible {
    outline: none;
  }

  /* Centred image area; flex:1 leaves the caption its own row so chrome never
     sits on top of the photograph (DESIGN: prints are shown clean). */
  .lightbox__figure {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .lightbox__img.is-ready {
    opacity: 1;
  }

  /* Mono caption + counter, pinned bottom-left within the editorial gutter. */
  .lightbox__meta {
    flex: 0 0 auto;
    align-self: flex-start;
    max-width: min(70ch, 100%);
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    text-align: left;
    pointer-events: none; /* never intercept a backdrop-to-close click */
  }
  .lightbox__caption {
    color: var(--muted);
    font-size: var(--fs-meta);
    line-height: 1.4;
  }
  .lightbox__caption[hidden] {
    display: none;
  }
  .lightbox__counter {
    color: var(--muted);
    font-size: var(--fs-meta);
    font-variant-numeric: tabular-nums;
  }

  /* Icon controls: 44px touch targets, quiet until hover/focus. */
  .lightbox__btn {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    color: var(--muted);
    transition:
      color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }
  .lightbox__btn:hover,
  .lightbox__btn:focus-visible {
    color: var(--ink);
    background: var(--accent-soft);
  }
  .lightbox__btn[hidden] {
    display: none;
  }

  .lightbox__close {
    top: var(--space-4);
    right: var(--space-4);
  }
  .lightbox__prev {
    left: var(--space-3);
    top: 50%;
    transform: translateY(-50%); /* static centring, not an animation */
  }
  .lightbox__next {
    right: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 600px) {
    .lightbox {
      padding: var(--space-8) var(--space-8) var(--space-4);
    }
    .lightbox__prev {
      left: var(--space-1);
    }
    .lightbox__next {
      right: var(--space-1);
    }
  }

  /* Reduced motion: open/close and image swaps are instant (opacity only,
     no transform animation). */
  @media (prefers-reduced-motion: reduce) {
    .lightbox,
    .lightbox.is-open,
    .lightbox__img {
      transition: none;
    }
  }
</style>
