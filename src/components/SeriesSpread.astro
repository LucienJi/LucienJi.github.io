---
// SeriesSpread — composes a few plates into ONE editorial spread: a 2-up diptych
// or a small 3-up cluster (or a single feature plate), honoring each photo's
// `span` (DESIGN.md §6.17 / §8.2). It is the spread/cluster composer PhotoEssay
// reaches for between full-bleed singles; it also stands alone.
//
// Justified row: each plate's width ∝ (aspect × span weight) over a 0 flex basis,
// so plates share one height while keeping true proportions. A `span:"wide"` photo
// claims ~1.5× the row weight, becoming the dominant plate of a diptych/cluster;
// a `span:"full"` photo (should it slip in) is treated as wide here — PhotoEssay
// normally renders "full" as its own full-bleed single instead. A lone plate is
// centered and height-capped so a portrait never towers.
//
// Each plate is a <PhotoPlate>, labelled "Plate <roman> — <place>" continuing
// from `startPlate`, and opens the shared <Lightbox>. Self-contained at the wide
// measure — do NOT re-wrap in another .wrap-* container.
//
//   <SeriesSpread photos={[a, b]} />              // diptych
//   <SeriesSpread photos={cluster} startPlate={3} />
import type { CollectionEntry } from "astro:content";
import PhotoPlate from "@components/PhotoPlate.astro";
import { mustResolveImage } from "@lib/images";

interface Props {
  /** A few photo ENTRIES (1–3 ideal) forming one spread. Rendered in order. */
  photos: CollectionEntry<"photos">[];
  /** 1-based plate number of the first photo (continuous numbering). */
  startPlate?: number;
  /** Eager-load the first plate when this spread is the page's LCP. */
  priority?: boolean;
  /** Extra classes on the root. */
  class?: string;
}
const {
  photos = [],
  startPlate = 1,
  priority = false,
  class: className = "",
} = Astro.props;

function toRoman(num: number): string {
  if (!Number.isFinite(num) || num <= 0) return String(num);
  const table: [number, string][] = [
    [1000, "M"], [900, "CM"], [500, "D"], [400, "CD"], [100, "C"],
    [90, "XC"], [50, "L"], [40, "XL"], [10, "X"], [9, "IX"],
    [5, "V"], [4, "IV"], [1, "I"],
  ];
  let n = Math.floor(num);
  let out = "";
  for (const [value, sym] of table) while (n >= value) { out += sym; n -= value; }
  return out;
}
function plateLabel(data: CollectionEntry<"photos">["data"], n: number): string {
  const place = [data.location, data.year].filter(Boolean).join(", ");
  const tail = place || data.caption || "";
  return tail ? `Plate ${toRoman(n)} — ${tail}` : `Plate ${toRoman(n)}`;
}

// span → row-weight multiplier; a "wide" plate dominates the spread. An editorial
// emphasis constant, not a spacing token.
const spanWeight = (span: CollectionEntry<"photos">["data"]["span"]): number =>
  span === "single" ? 1 : 1.5;

const aspectOf = (entry: CollectionEntry<"photos">): number => {
  if (entry.data.aspect && entry.data.aspect > 0) return entry.data.aspect;
  const meta = mustResolveImage(entry.data.src);
  return meta.width / meta.height;
};

const cells = photos.map((entry, i) => {
  const aspect = aspectOf(entry);
  return {
    entry,
    aspect,
    weight: aspect * spanWeight(entry.data.span),
    plate: startPlate + i,
    first: i === 0,
  };
});

const solo = cells.length === 1;
// Per-plate srcset hint scales with how many plates share the row.
const SIZES = solo
  ? "(min-width: 720px) 70vw, 100vw"
  : cells.length >= 3
    ? "(min-width: 720px) 32vw, 100vw"
    : "(min-width: 720px) 48vw, 100vw";
---

{
  cells.length > 0 && (
    <div class:list={["ss", { "ss--solo": solo }, className]}>
      <div class="ss__row">
        {cells.map((cell) => (
          <div
            class="ss__item"
            style={`--w:${cell.weight.toFixed(4)};--aspect:${cell.aspect.toFixed(4)}`}
          >
            <PhotoPlate
              photo={cell.entry.data}
              plateLabel={plateLabel(cell.entry.data, cell.plate)}
              priority={priority && cell.first}
              sizes={SIZES}
            />
          </div>
        ))}
      </div>
    </div>
  )
}

<style>
  /* Self-contained at the wide measure — do NOT wrap in another .wrap-*. */
  .ss {
    max-width: var(--measure-wide);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .ss__row {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
  }

  /* Justified plate: width ∝ weight (aspect × span) over a 0 basis. */
  .ss__item {
    flex-grow: var(--w);
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
  }

  /* Lone feature plate: centered and width-capped so a portrait never towers
     (height ≈ 72vh — a geometry constant outside the spacing scale). Landscapes
     simply fall back to the wide measure. */
  .ss--solo .ss__row {
    justify-content: center;
  }
  .ss--solo .ss__item {
    flex-grow: 0;
    flex-basis: auto;
    width: 100%;
    max-width: min(100%, calc(72vh * var(--aspect)));
  }

  /* Phones: stack the spread into one calm column. */
  @media (max-width: 820px) {
    .ss__row {
      flex-wrap: wrap;
      gap: var(--space-8);
    }
    .ss__item {
      flex-basis: 100%;
    }
    .ss--solo .ss__item {
      max-width: 100%;
    }
  }
</style>
