---
import { site } from "../data/site";
import ContactBlock from "./ContactBlock.astro";

const now = new Date();
const year = now.getFullYear();
const revised = now.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<footer class="colophon">
  <div class="wrap-wide colophon__inner">
    <div class="colophon__brand">
      <p class="colophon__name">{site.name}</p>
      <ContactBlock />
    </div>
    <div class="colophon__meta">
      <p class="meta">
        Set in Newsreader &amp; IBM Plex Mono · Built with
        <a class="link" href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
        · Last revised {revised}
      </p>
      <p class="meta colophon__copy">© {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .colophon {
    border-top: 1px solid var(--line);
    margin-top: var(--space-24);
    padding-block: var(--space-16);
  }
  .colophon__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    justify-content: space-between;
    align-items: flex-start;
  }
  .colophon__name {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    margin-bottom: var(--space-4);
  }
  .colophon__meta {
    text-align: right;
    display: grid;
    gap: var(--space-2);
  }
  .colophon__copy { color: var(--faint); }
  @media (max-width: 620px) {
    .colophon__meta { text-align: left; }
  }
</style>
