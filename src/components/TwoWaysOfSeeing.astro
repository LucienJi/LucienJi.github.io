---
// TwoWaysOfSeeing — the home "bridge" module (DESIGN.md §6.20 / §7.1 step 4).
// One research figure beside one photograph in IDENTICAL keyline frames, sharing
// the SAME mono caption grammar, tied together by one serif line of copy.
// Side-by-side on desktop, stacked on mobile. The shared frame is what makes a
// figure's metadata rhyme with a photograph's — "two ways of seeing".
//
//   <TwoWaysOfSeeing
//     figure="grasp-affordance.png" figureAlt="Predicted grasp affordances"
//     figureCaption="Fig. 12 — Learned affordances"
//     photo="kyoto-07.jpg" photoAlt="Lantern-lit street at dusk"
//     photoCaption="Plate VII — Kyoto, 2024" />
import ResponsiveImage from "@components/ResponsiveImage.astro";

interface Props {
  /** Research figure BASENAME (src/assets/**). */
  figure: string;
  /** REQUIRED alt for the research figure. */
  figureAlt: string;
  /** Optional mono caption below the figure (e.g. "Fig. 12 — …"). */
  figureCaption?: string;
  /** Photograph BASENAME (src/assets/**). */
  photo: string;
  /** REQUIRED alt for the photograph. */
  photoAlt: string;
  /** Optional mono caption below the photo (e.g. "Plate VII — Kyoto, 2024"). */
  photoCaption?: string;
  /** The bridging serif line of copy. */
  line?: string;
}
const {
  figure,
  figureAlt,
  figureCaption,
  photo,
  photoAlt,
  photoCaption,
  line = "Two ways of seeing the same world.",
} = Astro.props;

// Both plates share ONE aspect so the keyline frames are truly identical.
const FRAME_ASPECT = 4 / 3;
const sizes = "(min-width: 1140px) 540px, (min-width: 768px) 46vw, 100vw";
---

<figure class="tws">
  {line && <figcaption class="tws__line">{line}</figcaption>}
  <div class="tws__pair">
    <figure class="tws__item">
      <ResponsiveImage src={figure} alt={figureAlt} mat aspect={FRAME_ASPECT} sizes={sizes} />
      {figureCaption && <figcaption class="tws__caption">{figureCaption}</figcaption>}
    </figure>
    <figure class="tws__item">
      <ResponsiveImage src={photo} alt={photoAlt} mat aspect={FRAME_ASPECT} sizes={sizes} />
      {photoCaption && <figcaption class="tws__caption">{photoCaption}</figcaption>}
    </figure>
  </div>
</figure>

<style>
  /* Self-contained at the wide measure — do NOT wrap in another .wrap-*. */
  .tws {
    max-width: var(--measure-wide);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .tws__line {
    max-width: var(--measure-read);
    margin-bottom: var(--space-8);
    font-family: var(--font-serif);
    font-size: var(--fs-lede);
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
    text-wrap: balance;
  }

  .tws__pair {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 768px) {
    .tws__pair {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  /* Same mono caption grammar for figure AND photo (venue/year ≡ place/year). */
  .tws__caption {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.04em;
    line-height: 1.4;
    color: var(--faint);
  }
</style>
